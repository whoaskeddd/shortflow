APP_NAME=ShortFlow API
APP_ENV=development
APP_SECRET_KEY=change-me
APP_ACCESS_TOKEN_EXPIRE_MINUTES=30
APP_REFRESH_TOKEN_EXPIRE_MINUTES=10080
APP_DATABASE_URL=postgresql+psycopg://shortflow:shortflow@postgres:5432/shortflow
APP_REDIS_URL=redis://redis:6379/0
APP_STORAGE_BACKEND=local
APP_STORAGE_LOCAL_PATH=/app/data/uploads
APP_STORAGE_PUBLIC_BASE_URL=http://localhost:8000/uploads
APP_S3_ENDPOINT=http://minio:9000
APP_S3_ACCESS_KEY=shortflow
APP_S3_SECRET_KEY=shortflowsecret
APP_S3_BUCKET=shortflow
APP_MODERATION_ENABLED=true
APP_MODERATION_LANGUAGE=ru
APP_MODERATION_WHISPER_MODEL=base
APP_MODERATION_MAX_VIDEO_SECONDS=180
APP_MODERATION_TEXT_MODEL_ID=cointegrated/rubert-tiny-toxicity
APP_MODERATION_TEXT_MODEL_REVISION=fd5e387
APP_MODERATION_OBSCENITY_THRESHOLD=0.5
